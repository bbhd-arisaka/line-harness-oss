{
  "expo": {
    "name": "beyond line",
    "slug": "beyond-line",
    "version": "0.1.0",
    "scheme": "beyondline",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "jp.cms-manager.beyondline",
      "supportsTablet": false,
      "requireFullScreen": false,
      "infoPlist": {
        "CFBundleDisplayName": "beyond line",
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#06c755"
        }
      ],
      "expo-font",
      "expo-notifications",
      "expo-updates"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "959aad6e-128e-4235-980c-13d68e14e78f"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/959aad6e-128e-4235-980c-13d68e14e78f"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
